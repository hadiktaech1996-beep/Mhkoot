# ---- Required in production ----
SITE_URL=https://www.example.com
SESSION_SECRET=generate-with-openssl-rand-hex-32
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=choose-a-long-unique-password      # only used to create the first owner account

# ---- Data storage ----
# Default: JSON file store in DATA_DIR (single server only). For serverless/multi-instance hosting
# connect PostgreSQL/Supabase using db/schema.sql and replace lib/store.ts (see docs/DEPLOYMENT.md).
DATA_DIR=.data

# ---- Email (booking confirmations). Without SMTP, emails are NOT sent (logged only). ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sancak Tour <bookings@example.com>"
MAIL_NOTIFY_TO=bookings@example.com

# ---- Payments (TEST MODE ONLY until verified merchant accounts exist) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---- Optional integrations ----
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
INSTAGRAM_ACCESS_TOKEN=
